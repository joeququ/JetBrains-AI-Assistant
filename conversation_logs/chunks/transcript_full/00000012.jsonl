<!-- SECTION 1: 產品簡介 -->\n    <section id=\"sec-1\" class=\"bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden transition-all shadow-2xl\">\n      <div onclick=\"toggleSection('sec-1')\" class=\"p-5 sm:p-8 cursor-pointer hover:bg-slate-800/40 flex items-center justify-between transition-colors border-b border-slate-800/60 select-none\">\n        <div class=\"flex items-center gap-3 sm:gap-5\">\n          <span class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-indigo-500/20 border border-indigo-500/30 text-indigo-400 font-extrabold text-base sm:text-lg flex items-center justify-center shrink-0\">\n            01\n          </span>\n          <div>\n            <span class=\"text-xs sm:text-sm font-bold text-indigo-400 uppercase tracking-widest\">第一段：產品簡介</span>\n            <h2 class=\"text-xl sm:text-3xl lg:text-4xl font-extrabold text-white\">JetBrains AI Assistant 是什麼？高風控市場驗證與對比</h2>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-3\">\n          <span class=\"text-sm sm:text-base text-slate-400 font-semibold hidden sm:inline-block\">點擊展開 / 收起說明</span>\n          <div id=\"sec-1-icon\" class=\"w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-800 border border-slate-700 text-slate-300 flex items-center justify-center text-sm sm:text-base font-bold transition-transform duration-300\">\n            ▼\n          </div>\n        </div>\n      </div>\n\n      <div id=\"sec-1-content\" class=\"accordion-content accordion-closed p-5 sm:p-10 space-y-6 sm:space-y-8 bg-slate-950/60\">\n        <p class=\"text-slate-100 text-base sm:text-xl lg:text-2xl leading-relaxed font-normal\">\n          JetBrains IDE（IntelliJ IDEA, PyCharm, WebStorm, GoLand, Rider 等）在全台灣與全球各大金融機構、半導體龍頭、證券公司及高風控環境中，早已是不可或缺的標準開發工具。\n        </p>\n\n        <!-- Highlights Grid -->\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 text-base sm:text-lg\">\n          <div class=\"bg-slate-900 p-5 sm:p-6 rounded-xl border border-slate-800\">\n            <div class=\"text-indigo-400 font-black text-2xl sm:text-4xl lg:text-5xl mb-1.5 sm:mb-2\">90%+</div>\n            <h3 class=\"text-white font-extrabold text-base sm:text-xl mb-1\">金融與證券市場佔有率</h3>\n            <p class=\"text-slate-300 text-xs sm:text-base\">通過最嚴苛的企業 IT 資安審查。</p>\n          </div>\n          <div class=\"bg-slate-900 p-5 sm:p-6 rounded-xl border border-slate-800\">\n            <div class=\"text-purple-400 font-black text-2xl sm:text-4xl lg:text-5xl mb-1.5 sm:mb-2\">20+ 年</div>\n            <h3 class=\"text-white font-extrabold text-base sm:text-xl mb-1\">靜態分析經驗積澱</h3>\n            <p class=\"text-slate-300 text-xs sm:text-base\">具備全球最頂尖的抽象語法樹 (PSI) 能力。</p>\n          </div>\n          <div class=\"bg-slate-900 p-5 sm:p-6 rounded-xl border border-slate-800\">\n            <div class=\"text-pink-400 font-black text-2xl sm:text-4xl lg:text-5xl mb-1.5 sm:mb-2\">100%</div>\n            <h3 class=\"text-white font-extrabold text-base sm:text-xl mb-1\">企業合規與安全架構</h3>\n            <p class=\"text-slate-300 text-xs sm:text-base\">提供 SOC 2 Type II、GDPR 認證與離線模式。</p>\n          </div>\n        </div>\n\n        <!-- Comparison Table -->\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-left text-xs sm:text-base lg:text-lg border-collapse\">\n            <thead>\n              <tr class=\"bg-slate-900 border-b border-slate-800 text-slate-200\">\n                <th class=\"p-3 sm:p-4 font-extrabold\">比較維度</th>\n                <th class=\"p-3 sm:p-4 font-extrabold text-amber-300\">輕量外掛 / 獨立 CLI (如 Claude Code)</th>\n                <th class=\"p-3 sm:p-4 font-extrabold text-indigo-300\">JetBrains AI Assistant 平台</th>\n              </tr>\n            </thead>\n            <tbody class=\"divide-y divide-slate-800/60 text-slate-200\">\n              <tr>\n                <td class=\"p-3 sm:p-4 font-bold text-white\">專案上下文理解</td>\n                <td class=\"p-3 sm:p-4 text-slate-400\">僅文字檔檢索，易遺漏跨檔案繼承</td>\n                <td class=\"p-3 sm:p-4 font-bold text-indigo-300\">PSI 抽象語法樹 + 全專案符號索引</td>\n              </tr>\n              <tr>\n                <td class=\"p-3 sm:p-4 font-bold text-white\">介面與審查</td>\n                <td class=\"p-3 sm:p-4 text-slate-400\">純命令行 (CLI)，需手動切換視窗</td>\n                <td class=\"p-3 sm:p-4 font-bold text-indigo-300\">IDE 原生二元 Diff 審查與一鍵替換</td>\n              </tr>\n              <tr>\n                <td class=\"p-3 sm:p-4 font-bold text-white\">模型選擇</td>\n                <td class=\"p-3 sm:p-4 text-slate-400\">綁定單一模型供應商</td>\n                <td class=\"p-3 sm:p-4 font-black text-indigo-300 bg-indigo-950/40\">可調用 Claude / GPT / Gemini 切換</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <!-- 2026 年銷售報告預覽卡片 -->\n        <div class=\"bg-indigo-950/40 border border-indigo-500/40 rounded-2xl p-5 sm:p-6 text-xs sm:text-base lg:text-lg space-y-2.5 sm:space-y-3\">\n          <div class=\"flex items-center justify-between\">\n            <span class=\"font-bold text-indigo-300 text-sm sm:text-lg lg:text-xl flex items-center gap-2\">\n              📊 JetBrains 2026 年度銷售與營運報告預覽 (Annual Report Preview)\n            </span>\n            <span class=\"px-2.5 py-0.5 sm:px-3 sm:py-1 rounded bg-indigo-500/20 text-indigo-300 font-mono text-[10px] sm:text-sm\">Official Insights</span>\n          </div>\n          <p class=\"text-slate-200 leading-relaxed\">\n            JetBrains 2026 年度報告顯示：全球已有超過 1,500 萬名專業開發者與 100,000+ 家企業客戶持續選擇 JetBrains。年營收與企業級授權持續維持強勁雙位數成長，證明在高風控、大規模開發環境中的不可替代性與產業信任度。\n          </p>\n          <div class=\"pt-1 sm:pt-2 text-right\">\n            <a href=\"https://www.jetbrains.com/lp/annualreport-2026/\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">\n              閱讀完整的 JetBrains 2026 年度報告 (Annual Report 2026) 🔗\n            </a>\n          </div>\n        </div>\n\n        <div class=\"flex items-center justify-between pt-3 sm:pt-4 border-t border-slate-800/80 text-xs sm:text-base\">\n          <span class=\"text-slate-400\">參考原廠說明連結：</span>\n          <a href=\"https://www.jetbrains.com/business/#lean-in\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">https://www.jetbrains.com/business/#lean-in 🔗</a>\n        </div>\n      </div>\n    </section>\n\n    <!-- SECTION 2: 產品優勢 -->\n    <section id=\"sec-2\" class=\"bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden transition-all shadow-2xl\">\n      <div onclick=\"toggleSection('sec-2')\" class=\"p-5 sm:p-8 cursor-pointer hover:bg-slate-800/40 flex items-center justify-between transition-colors border-b border-slate-800/60 select-none\">\n        <div class=\"flex items-center gap-3 sm:gap-5\">\n          <span class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-purple-500/20 border border-purple-500/30 text-purple-400 font-extrabold text-base sm:text-lg flex items-center justify-center shrink-0\">\n            02\n          </span>\n          <div>\n            <span class=\"text-xs sm:text-sm font-bold text-purple-400 uppercase tracking-widest\">第二段：產品優勢</span>\n            <h2 class=\"text-xl sm:text-3xl lg:text-4xl font-extrabold text-white\">靜態代碼分析 (PSI) + 上下文感知：杜絕 AI 幻覺</h2>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-3\">\n          <span class=\"text-sm sm:text-base text-slate-400 font-semibold hidden sm:inline-block\">點擊展開 / 收起說明</span>\n          <div id=\"sec-2-icon\" class=\"w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-800 border border-slate-700 text-slate-300 flex items-center justify-center text-sm sm:text-base font-bold transition-transform duration-300\">\n            ▼\n          </div>\n        </div>\n      </div>\n\n      <div id=\"sec-2-content\" class=\"accordion-content accordion-closed p-5 sm:p-10 space-y-6 sm:space-y-8 bg-slate-950/60\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 text-sm sm:text-lg lg:text-xl\">\n          <div class=\"bg-slate-900 p-5 sm:p-7 rounded-2xl border border-slate-800\">\n            <h3 class=\"text-amber-400 font-extrabold text-base sm:text-xl mb-3 sm:mb-4\">傳統 Agent Coding 常見問題</h3>\n            <ul class=\"space-y-2.5 sm:space-y-3 text-slate-200\">\n              <li>• <strong>AI 幻覺 (Hallucination)</strong>：生成不存在的方法或錯誤傳參。</li>\n              <li>• <strong>上下文丟失</strong>：專案變大時丟失深層調用鏈與型別繼承。</li>\n              <li>• <strong>編譯失敗</strong>：產生不符合專案架構規範的寫法。</li>\n            </ul>\n          </div>\n\n          <div class=\"bg-indigo-950/30 p-5 sm:p-7 rounded-2xl border border-indigo-500/30\">\n            <h3 class=\"text-indigo-300 font-extrabold text-base sm:text-xl mb-3 sm:mb-4\">JetBrains 獨家靜態分析解法</h3>\n            <ul class=\"space-y-2.5 sm:space-y-3 text-slate-100\">\n              <li>• <strong>PSI 抽象語法樹預檢</strong>：AI 輸出前先經由 IDE 完成靜態檢查。</li>\n              <li>• <strong>Smart Debugging 診斷</strong>：直連 Debugger 擷取 Stack Trace 解決異常。</li>\n              <li>• <strong>一鍵生成 Git & Test</strong>：自動規範 Commit Message 並補全測試。</li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"flex items-center justify-between pt-3 sm:pt-4 border-t border-slate-800/80 text-xs sm:text-base\">\n          <span class=\"text-slate-400\">原廠說明連結：</span>\n          <div class=\"flex items-center gap-4 sm:gap-6\">\n            <a href=\"https://www.jetbrains.com/help/idea/code-inspection.html\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">Code Inspection Engine 🔗</a>\n            <a href=\"https://www.jetbrains.com/help/ai-assistant/ai-chat.html\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">JetBrains AI Chat Docs 🔗</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- SECTION 3: 計費與模型優勢 -->\n    <section id=\"sec-3\" class=\"bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden transition-all shadow-2xl\">\n      <div onclick=\"toggleSection('sec-3')\" class=\"p-5 sm:p-8 cursor-pointer hover:bg-slate-800/40 flex items-center justify-between transition-colors border-b border-slate-800/60 select-none\">\n        <div class=\"flex items-center gap-3 sm:gap-5\">\n          <span class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-pink-500/20 border border-pink-500/30 text-pink-400 font-extrabold text-base sm:text-lg flex items-center justify-center shrink-0\">\n            03\n          </span>\n          <div>\n            <span class=\"text-xs sm:text-sm font-bold text-pink-400 uppercase tracking-widest\">第三段：計費與模型優勢</span>\n            <h2 class=\"text-xl sm:text-3xl lg:text-4xl font-extrabold text-white\">不綁定單一 LLM，同一平台自由切換你愛的 Agent</h2>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-3\">\n          <span class=\"text-sm sm:text-base text-slate-400 font-semibold hidden sm:inline-block\">點擊展開 / 收起說明</span>\n          <div id=\"sec-3-icon\" class=\"w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-800 border border-slate-700 text-slate-300 flex items-center justify-center text-sm sm:text-base font-bold transition-transform duration-300\">\n            ▼\n          </div>\n        </div>\n      </div>\n\n      <div id=\"sec-3-content\" class=\"accordion-content accordion-closed p-5 sm:p-10 space-y-6 sm:space-y-8 bg-slate-950/60\">\n        <div class=\"bg-indigo-950/30 border border-indigo-500/30 rounded-2xl p-5 sm:p-7 text-sm sm:text-lg lg:text-xl\">\n          <h3 class=\"text-white font-extrabold text-lg sm:text-2xl mb-2 sm:mb-3\">回答客戶：「我們習慣用 Claude 3.5 Sonnet，換成 JetBrains 是不是要放棄？」</h3>\n          <p class=\"text-indigo-200 font-bold mb-4 sm:mb-5\">答：完全不需要！JetBrains AI 是開放平台，已原生整合全球最強 LLM 模型。</p>\n\n          <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-5 text-center\">\n            <div class=\"bg-slate-900 p-4 sm:p-5 rounded-xl border border-slate-800\">\n              <div class=\"text-amber-400 font-bold text-xs sm:text-base\">Anthropic</div>\n              <div class=\"text-white font-black text-sm sm:text-xl\">Claude 3.5 Sonnet</div>\n            </div>\n            <div class=\"bg-slate-900 p-4 sm:p-5 rounded-xl border border-slate-800\">\n              <div class=\"text-emerald-400 font-bold text-xs sm:text-base\">OpenAI</div>\n              <div class=\"text-white font-black text-sm sm:text-xl\">GPT-4o</div>\n            </div>\n            <div class=\"bg-slate-900 p-4 sm:p-5 rounded-xl border border-slate-800\">\n              <div class=\"text-sky-400 font-bold text-xs sm:text-base\">Google</div>\n              <div class=\"text-white font-black text-sm sm:text-xl\">Gemini 1.5 Pro</div>\n            </div>\n            <div class=\"bg-slate-900 p-4 sm:p-5 rounded-xl border border-slate-800\">\n              <div class=\"text-purple-400 font-bold text-xs sm:text-base\">JetBrains</div>\n              <div class=\"text-white font-black text-sm sm:text-xl\">Mellum (自研)</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"flex items-center justify-between pt-3 sm:pt-4 border-t border-slate-800/80 text-xs sm:text-base\">\n          <span class=\"text-slate-400\">原廠條款背書：</span>\n          <div class=\"flex items-center gap-4 sm:gap-6\">\n            <a href=\"https://www.jetbrains.com/ai/\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">JetBrains Supported LLMs 🔗</a>\n            <a href=\"https://www.jetbrains.com/legal/docs/terms/jetbrains-ai-service/\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">JetBrains AI Service Agreement 🔗</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- SECTION 4: 帳務管理優勢 -->\n    <section id=\"sec-4\" class=\"bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden transition-all shadow-2xl\">\n      <div onclick=\"toggleSection('sec-4')\" class=\"p-5 sm:p-8 cursor-pointer hover:bg-slate-800/40 flex items-center justify-between transition-colors border-b border-slate-800/60 select-none\">\n        <div class=\"flex items-center gap-3 sm:gap-5\">\n          <span class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-extrabold text-base sm:text-lg flex items-center justify-center shrink-0\">\n            04\n          </span>\n          <div>\n            <span class=\"text-xs sm:text-sm font-bold text-emerald-400 uppercase tracking-widest\">第四段：帳務管理優勢</span>\n            <h2 class=\"text-xl sm:text-3xl lg:text-4xl font-extrabold text-white\">JetBrains Central Console：財務與 IT 的中央管理利器</h2>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-3\">\n          <span class=\"text-sm sm:text-base text-slate-400 font-semibold hidden sm:inline-block\">點擊展開 / 收起說明</span>\n          <div id=\"sec-4-icon\" class=\"w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-800 border border-slate-700 text-slate-300 flex items-center justify-center text-sm sm:text-base font-bold transition-transform duration-300\">\n            ▼\n          </div>\n        </div>\n      </div>\n\n      <div id=\"sec-4-content\" class=\"accordion-content accordion-closed p-5 sm:p-10 space-y-6 sm:space-y-8 bg-slate-950/60\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 text-sm sm:text-lg lg:text-xl\">\n          <div class=\"bg-slate-900 p-5 sm:p-7 rounded-2xl border border-slate-800\">\n            <h3 class=\"text-white font-extrabold text-base sm:text-2xl mb-2 sm:mb-3\">一站式中央帳務與配額儀表板</h3>\n            <p class=\"text-slate-200 leading-relaxed\">\n              <strong>AI Credits 統一積分機制</strong>：全公司用量、剩餘額度一目瞭然。財務部門再也不用每個月處理大量分散的海外信用卡簽帳與請購比價。\n            </p>\n          </div>\n          <div class=\"bg-slate-900 p-5 sm:p-7 rounded-2xl border border-slate-800\">\n            <h3 class=\"text-white font-extrabold text-base sm:text-2xl mb-2 sm:mb-3\">精準組織權限控管 (Quota Allocation)</h3>\n            <p class=\"text-slate-200 leading-relaxed\">\n              IT 管理員可針對團隊或部門設定用量上限，防止少數人員超用導致費用暴增，提供完整審計報表。\n            </p>\n          </div>\n        </div>\n\n        <div class=\"flex items-center justify-between pt-3 sm:pt-4 border-t border-slate-800/80 text-xs sm:text-base\">\n          <span class=\"text-slate-400\">原廠文件背書：</span>\n          <div class=\"flex items-center gap-4 sm:gap-6\">\n            <a href=\"https://www.jetbrains.com/help/jetbrains-console/about-jetbrains-console.html\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">About JetBrains Console 🔗</a>\n            <a href=\"https://www.jetbrains.com/legal/docs/terms/jetbrains-ai-credits/1.0/\" target=\"_blank\" class=\"text-indigo-400 font-bold hover:underline\">JetBrains AI Credits Terms 1.0 🔗</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- SECTION 5: 安全可信度聲明 -->\n    <section id=\"sec-5\" class=\"bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden transition-all shadow-2xl\">\n      <div onclick=\"toggleSection('sec-5')\" class=\"p-5 sm:p-8 cursor-pointer hover:bg-slate-800/40 flex items-center justify-between transition-colors border-b border-slate-800/60 select-none\">\n        <div class=\"flex items-center gap-3 sm:gap-5\">\n          <span class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-amber-500/20 border border-amber-500/30 text-amber-400 font-extrabold text-base sm:text-lg flex items-center justify-center shrink-0\">\n            05\n          </span>\n          <div>\n            <span class=\"text-xs sm:text-sm font-bold text-amber-400 uppercase tracking-widest\">第五段：安全可信度聲明</span>\n            <h2 class=\"text-xl sm:text-3xl lg:text-4xl font-extrabold text-white\">🛡️ 控制面/數據面分離、零訓練承諾與 Trust Center</h2>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-3\">\n          <span class=\"text-sm sm:text-base text-slate-400 font-semibold hidden sm:inline-block\">點擊展開 / 收起說明</span>\n          <div id=\"sec-5-icon\" class=\"w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-800 border border-slate-700 text-slate-300 flex items-center justify-center text-sm sm:text-base font-bold transition-transform duration-300\">\n            ▼\n          </div>\n        </div>\n      </div>\n\n      <div id=\"sec-5-content\" class=\"accordion-content accordion-closed p-5 sm:p-10 space-y-6 sm:space-y-8 bg-slate-950/60\">\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 text-sm sm:text-lg\">\n          <div class=\"bg-slate-900 p-5 sm:p-6 rounded-xl border border-slate-800\">\n            <h3 class=\"text-amber-400 font-bold text-base sm:text-xl mb-1.5 sm:mb-2\">1. 控制面與數據面分離</h3>\n            <p class=\"text-slate-200 text-xs sm:text-base\">JetBrains Central 僅管理授權與點數，原始碼在端點加密傳送，管理伺服器零儲存。</p>\n          </div>\n          <div class=\"bg-slate-900 p-5 sm:p-6 rounded-xl border border-slate-800\">\n            <h3 class=\"text-amber-400 font-bold text-base sm:text-xl mb-1.5 sm:mb-2\">2. 100% No-Training 承諾</h3>\n            <p class=\"text-slate-200 text-xs sm:text-base\">JetBrains 及 Anthropic, OpenAI, Google 簽約保證：絕不用於公共模型訓練。</p>\n          </div>\n          <div class=\"bg-slate-900 p-5 sm:p-6 rounded-xl border border-slate-800\">\n            <h3 class=\"text-amber-400 font-bold text-base sm:text-xl mb-1.5 sm:mb-2\">3. 30 天銷毀與 SOC 2</h3>\n            <p class=\"text-slate-200 text-xs sm:text-base\">暫存數據最長 30 天強制自動銷毀。通過 SOC 2 Type II 與 GDPR 驗證。</p>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 text-center text-sm sm:text-lg\">\n          <h4 class=\"text-white font-extrabold text-base sm:text-xl mb-2\">JetBrains 原廠 Trust Center 權威背書 portal：</h4>\n          <a href=\"https://trust-center.jetbrains.com/\" target=\"_blank\" class=\"inline-flex items-center gap-2 text-emerald-400 font-bold text-base sm:text-xl hover:underline\">\n            https://trust-center.jetbrains.com/ 🔗\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <!-- SECTION 6: 在地服務 -->\n    <section id=\"sec-6\" class=\"bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden transition-all shadow-2xl\">\n      <div onclick=\"toggleSection('sec-6')\" class=\"p-5 sm:p-8 cursor-pointer hover:bg-slate-800/40 flex items-center justify-between transition-colors border-b border-slate-800/60 select-none\">\n        <div class=\"flex items-center gap-3 sm:gap-5\">\n          <span class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-sky-500/20 border border-sky-500/30 text-sky-400 font-extrabold text-base sm:text-lg flex items-center justify-center shrink-0\">\n            06\n          </span>\n          <div>\n            <span class=\"text-xs sm:text-sm font-bold text-sky-400 uppercase tracking-widest\">第六段：在地服務 (迪凱科技 AHASoft)</span>\n            <h2 class=\"text-xl sm:text-3xl lg:text-4xl font-extrabold text-white\">代購/代支代付痛點 vs. JetBrains Central Console 解法</h2>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-3\">\n          <span class=\"text-sm sm:text-base text-slate-400 font-semibold hidden sm:inline-block\">點擊展開 / 收起說明</span>\n          <div id=\"sec-6-icon\" class=\"w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-800 border border-slate-700 text-slate-300 flex items-center justify-center text-sm sm:text-base font-bold transition-transform duration-300\">\n            ▼\n          </div>\n        </div>\n      </div>\n\n      <div id=\"sec-6-content\" class=\"accordion-content accordion-closed p-5 sm:p-10 space-y-6 sm:space-y-8 bg-slate-950/60\">\n        \n        <!-- PART 1: 代購痛點與 Central Console 解法 -->\n        <div class=\"space-y-4 sm:space-y-5\">\n          <div class=\"flex items-center justify-between\">\n            <h3 class=\"text-slate-100 font-extrabold text-sm sm:text-xl flex items-center gap-2 sm:gap-3\">\n              <span class=\"px-2 py-0.5 sm:px-3 sm:py-1 rounded-md bg-red-950 border border-red-800 text-red-400 text-xs sm:text-sm\">第一部分</span>\n              坊間各大 LLM 散買與代購痛點對比（點擊痛點可直接跳出 Central Console 解法）：\n            </h3>\n          </div>\n\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 text-sm sm:text-lg\">\n            \n            <div onclick=\"togglePainSolution('sol-1')\" class=\"bg-slate-900 border border-slate-800 hover:border-sky-500/60 p-5 sm:p-6 rounded-2xl cursor-pointer transition-all\">\n              <div class=\"flex items-center justify-between text-red-400 font-extrabold mb-2 sm:mb-3 text-base sm:text-xl\">\n                <span class=\"flex items-center gap-2\">✕ 痛點一：必須向客戶索取帳號密碼</span>\n                <span class=\"text-xs sm:text-sm text-sky-400 underline\">點擊看解法 ▼</span>\n              </div>\n              <p class=\"text-slate-300 leading-relaxed mb-2 sm:mb-3 text-xs sm:text-base\">代購往往需要客戶提供管理員登入帳密，產生巨大的資安破口與權限風險。</p>\n              \n              <div id=\"sol-1\" class=\"hidden mt-3 sm:mt-4 p-3.5 sm:p-4 bg-sky-950/50 border border-sky-500/40 rounded-xl text-sky-100 text-xs sm:text-base\">\n                <strong class=\"text-white block mb-1 text-sm sm:text-lg\">✓ JetBrains Central Console 解法：</strong>\n                迪凱科技 AHASoft 直接針對貴公司 JetBrains Console 開通授權與 Credits 充值，完全無需透露任何帳號密碼！\n              </div>\n            </div>\n\n            <div onclick=\"togglePainSolution('sol-2')\" class=\"bg-slate-900 border border-slate-800 hover:border-sky-500/60 p-5 sm:p-6 rounded-2xl cursor-pointer transition-all\">\n              <div class=\"flex items-center justify-between text-red-400 font-extrabold mb-2 sm:mb-3 text-base sm:text-xl\">\n                <span class=\"flex items-center gap-2\">✕ 痛點二：最低採購數量限制與鎖定</span>\n                <span class=\"text-xs sm:text-sm text-sky-400 underline\">點擊看解法 ▼</span>\n              </div>\n              <p class=\"text-slate-300 leading-relaxed mb-2 sm:mb-3 text-xs sm:text-base\">原廠規定高額起訂量，團隊超用時遭到全盤鎖定，影響專案進度無所適從。</p>\n              \n              <div id=\"sol-2\" class=\"hidden mt-3 sm:mt-4 p-3.5 sm:p-4 bg-sky-950/50 border border-sky-500/40 rounded-xl text-sky-100 text-xs sm:text-base\">\n                <strong class=\"text-white block mb-1 text-sm sm:text-lg\">✓ JetBrains Central Console 解法：</strong>\n                零最低數量限制！AI Credits 採彈性充值（10 USD 起算），且 Console 儀表板隨時掌握用量，告別無故鎖定。\n              </div>\n            </div>\n\n            <div onclick=\"togglePainSolution('sol-3')\" class=\"bg-slate-900 border border-slate-800 hover:border-sky-500/60 p-5 sm:p-6 rounded-2xl cursor-pointer transition-all\">\n              <div class=\"flex items-center justify-between text-red-400 font-extrabold mb-2 sm:mb-3 text-base sm:text-xl\">\n                <span class=\"flex items-center gap-2\">✕ 痛點三：原廠政策朝令夕改與天天出新 AI</span>\n                <span class=\"text-xs sm:text-sm text-sky-400 underline\">點擊看解法 ▼</span>\n              </div>\n              <p class=\"text-slate-300 leading-relaxed mb-2 sm:mb-3 text-xs sm:text-base\">市場每天出新 AI，同仁分散要求開請購單；原廠政策缺乏長期遵循標準。</p>\n              \n              <div id=\"sol-3\" class=\"hidden mt-3 sm:mt-4 p-3.5 sm:p-4 bg-sky-950/50 border border-sky-500/40 rounded-xl text-sky-100 text-xs sm:text-base\">\n                <strong class=\"text-white block mb-1 text-sm sm:text-lg\">✓ JetBrains Central Console 解法：</strong>\n                單一平台包辦 Claude, GPT, Gemini 與 Mellum，不用今天買這家、明天買那家，一套 Console 管理全公司！\n              </div>\n            </div>\n\n            <div onclick=\"togglePainSolution('sol-4')\" class=\"bg-slate-900 border border-slate-800 hover:border-sky-500/60 p-5 sm:p-6 rounded-2xl cursor-pointer transition-all\">\n              <div class=\"flex items-center justify-between text-red-400 font-extrabold mb-2 sm:mb-3 text-base sm:text-xl\">\n                <span class=\"flex items-center gap-2\">✕ 痛點四：海外客服求助無門與帳務繁瑣</span>\n                <span class=\"text-xs sm:text-sm text-sky-400 underline\">點擊看解法 ▼</span>\n              </div>\n              <p class=\"text-slate-300 leading-relaxed mb-2 sm:mb-3 text-xs sm:text-base\">海外客服一等就是幾週，財務每月處理大量分散外幣信用卡請購。</p>\n              \n              <div id=\"sol-4\" class=\"hidden mt-3 sm:mt-4 p-3.5 sm:p-4 bg-sky-950/50 border border-sky-500/40 rounded-xl text-sky-100 text-xs sm:text-base\">\n                <strong class=\"text-white block mb-1 text-sm sm:text-lg\">✓ 迪凱科技 AHASoft 在地服務解法：</strong>\n                迪凱科技 AHASoft 提供台灣在地單一窗口服務與合規台幣發票，輕鬆完成核銷！\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n        <!-- PART 2: 代支代付真實窘境 -->\n        <div class=\"mt-6 sm:mt-8 pt-5 sm:pt-6 border-t border-slate-800/80 bg-slate-900/90 border border-slate-800 p-5 sm:p-7 rounded-2xl text-xs sm:text-lg space-y-3 sm:space-y-4\">\n          <div class=\"flex items-center gap-2 sm:gap-3 text-amber-400 font-black text-sm sm:text-xl\">\n            <svg class=\"w-5 h-5 sm:w-6 sm:h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\"></path></svg>\n            第二部分：在代支代付 (Advance Payment) 上時常遇到的真實窘境與業務心聲\n          </div>\n          <p class=\"text-slate-100 leading-relaxed font-medium\">\n            我們作為業務員，過去在嘗試幫客戶辦理各大 LLM 供應商（Github Copilot / ChatGPT / Claude / Gemini）代支代付時，深刻體會到無奈：\n          </p>\n          <ul class=\"text-slate-200 space-y-2 sm:space-y-3 pl-5 sm:pl-6 list-disc\">\n            <li><strong>帳單與匯率浮動劇烈</strong>：外幣簽帳的手續費、浮動匯率與增購充值通路不明確，讓財務與採購相當頭痛。</li>\n            <li><strong>無權限管理與缺乏企業級控管</strong>：代購產品無法提供企業 Central 儀表板，無法進行人員離職權限回收或用量上限預防。</li>\n            <li><strong>非授權經銷的後續無保障</strong>：散買代購本質上只是「代代支付」，缺乏原廠政策定性與在地技術支援。</li>\n          </ul>\n          <div class=\"pt-3 sm:pt-4 text-sky-300 font-extrabold text-sm sm:text-xl border-t border-slate-800/80\">\n            👉 **選擇「迪凱科技 AHASoft」代理的 JetBrains AI 生態**，才能徹底將「代購」轉變為「可控、可信、長期依賴的企業級服務」！\n          </div>\n        </div>\n\n      </div>\n    </section>\n\n  </main>\n\n  <!-- CTA Footer Section -->\n  <section class=\"py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center\">\n    <div class=\"bg-slate-900 border border-slate-800 rounded-3xl p-8 sm:p-12 shadow-2xl\">\n      <h2 class=\"text-2xl sm:text-5xl font-black text-white mb-4 sm:mb-6 leading-tight\">\n        「你可以不接受，但是我建議你試試看！<br/>\n        <span class=\"bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent\">\n          在現今這個年代，試試看往往不吃虧。」\n        </span>\n      </h2>\n      <p class=\"text-slate-200 text-base sm:text-xl leading-relaxed mb-6 sm:mb-8\">\n        迪凱科技 AHASoft 誠摯邀請貴團隊開啟 <strong>JetBrains AI 30 天免責企業試用</strong>。\n      </p>\n      <button onclick=\"openTrialModal()\" class=\"px-8 py-3.5 sm:px-10 sm:py-4.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-sm sm:text-lg shadow-xl shadow-indigo-600/30 transition-all\">\n        免費申請 30 天 Enterprise 企業試用 ➔\n      </button>\n\n      <div class=\"mt-8 pt-6 border-t border-slate-800/80 text-xs text-slate-400 flex items-center justify-between\">\n        <span>© 迪凱科技 AHASoft - JetBrains 台灣官方代理商</span>\n        <button onclick=\"forceHardRefresh()\" class=\"hover:text-indigo-300 underline font-mono\">\n          🔄 重新載入最新版本 (Clear Cache)\n        </button>\n      </div>\n    </div>\n  </section>\n\n  <!-- Enterprise Trial Modal -->\n  <div id=\"trial-modal\" class=\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4\">\n    <div class=\"bg-slate-900 border border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 relative shadow-2xl max-h-[90vh] overflow-y-auto\">\n      <button onclick=\"closeTrialModal()\" class=\"absolute top-4 right-4 sm:top-5 sm:right-5 text-slate-400 hover:text-white text-xl\">✕</button>\n\n      <div class=\"text-center mb-5 sm:mb-6\">\n        <div class=\"w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-indigo-500/20 text-indigo-400 font-bold text-base sm:text-lg flex items-center justify-center mx-auto mb-2 sm:mb-3\">\n          JB\n        </div>\n        <h3 class=\"text-white font-extrabold text-xl sm:text-2xl\">申請 JetBrains AI 30 天企業試用</h3>\n        <p class=\"text-slate-400 text-xs sm:text-base mt-1 sm:mt-1.5\">請填寫以下資訊，迪凱科技 AHASoft 專員將於 24 小時內專人連繫。</p>\n      </div>\n\n      <form onsubmit=\"submitTrialForm(event)\" class=\"space-y-3.5 sm:space-y-4 text-xs sm:text-base\">\n        <div>\n          <label class=\"block text-slate-200 font-bold mb-1 sm:mb-1.5\">1. 公司名稱 *</label>\n          <input type=\"text\" required placeholder=\"例如：某某金控 / 科技股份有限公司\" class=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 text-slate-100 focus:outline-none focus:border-indigo-500\">\n        </div>\n\n        <div>\n          <label class=\"block text-slate-200 font-bold mb-1 sm:mb-1.5\">2. 聯絡人姓名 *</label>\n          <input type=\"text\" required placeholder=\"例如：王小明 經理 / IT 處長\" class=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 text-slate-100 focus:outline-none focus:border-indigo-500\">\n        </div>\n\n        <div>\n          <label class=\"block text-slate-200 font-bold mb-1 sm:mb-1.5\">3. 公司 Mail *</label>\n          <input type=\"email\" required placeholder=\"name@company.com.tw\" class=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 text-slate-100 focus:outline-none focus:border-indigo-500\">\n        </div>\n\n        <div>\n          <label class=\"block text-slate-200 font-bold mb-1 sm:mb-1.5\">4. 預計有多少開發者申請 *</label>\n          <select required class=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 text-slate-100 focus:outline-none focus:border-indigo-500\">\n            <option value=\"\">-- 請選擇預計人數 --</option>\n            <option value=\"1-5\">1 - 5 人 (小型團隊測試)</option>\n            <option value=\"6-20\">6 - 20 人 (部門團隊評估)</option>\n            <option value=\"21-50\">21 - 50 人 (大規模團隊評估)</option>\n            <option value=\"51-100\">51 - 100 人 (事業群 POC)</option>\n            <option value=\"100+\">100 人以上 (全企業部署)</option>\n          </select>\n        </div>\n\n        <div>\n          <label class=\"block text-slate-200 font-bold mb-1 sm:mb-1.5\">5. 預計試用多久？ *</label>\n          <select required class=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 text-slate-100 focus:outline-none focus:border-indigo-500\">\n            <option value=\"\">-- 請選擇預計試用天數 --</option>\n            <option value=\"14天\">14 天 (快速功能 POC)</option>\n            <option value=\"30天\" selected>30 天 (標準企業完整試用)</option>\n            <option value=\"60天\">60 天 (大規模概念驗證)</option>\n            <option value=\"專人洽談\">專人專案洽談規劃</option>\n          </select>\n        </div>\n\n        <div>\n          <label class=\"block text-slate-200 font-bold mb-1 sm:mb-1.5\">6. 透過那裡得知我們？ *</label>\n          <select required class=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 text-slate-100 focus:outline-none focus:border-indigo-500\">\n            <option value=\"\">-- 請選擇管道 --</option>\n            <option value=\"網路搜尋\">Google / 網路搜尋引擎</option>\n            <option value=\"JetBrains 官網\">JetBrains 官方網站引導</option>\n            <option value=\"業務聯繫/推廣\">迪凱科技業務團隊主動聯繫與簡報</option>\n            <option value=\"同行/同事推薦\">朋友 / 同行 / 同事推薦介紹</option>\n            <option value=\"研討會/活動\">研討會 / 技術展覽 / 線上講座</option>\n            <option value=\"社群媒體\">FB / LinkedIn / 社群媒體</option>\n            <option value=\"其他\">其他</option>\n          </select>\n        </div>\n\n        <button type=\"submit\" class=\"w-full py-3.5 sm:py-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-xs sm:text-base shadow-lg shadow-indigo-600/30 transition-all mt-2 sm:mt-3\">\n          送出申請 (由迪凱科技 AHASoft 專員聯繫)\n        </button>\n      </form>\n    </div>\n  </div>\n\n  <!-- Vanilla JavaScript Control Scripts -->\n  <script>\n    function forceHardRefresh() {\n      const cleanUrl = window.location.protocol + \"//\" + window.location.host + window.location.pathname;\n      window.location.href = cleanUrl + '?refresh=' + new Date().getTime();\n    }\n\n    function toggleSection(secId) {\n      const content = document.getElementById(`${secId}-content`);\n      const icon = document.getElementById(`${secId}-icon`);\n      const isClosed = content.classList.contains('accordion-closed');\n\n      if (isClosed) {\n        content.classList.remove('accordion-closed');\n        content.classList.add('accordion-open');\n        icon.textContent = '▲';\n        icon.classList.add('bg-indigo-600', 'text-white');\n      } else {\n        content.classList.remove('accordion-open');\n        content.classList.add('accordion-closed');\n        icon.textContent = '▼';\n        icon.classList.remove('bg-indigo-600', 'text-white');\n      }\n    }\n\n    function navigateToSection(secId) {\n      const section = document.getElementById(secId);\n      const content = document.getElementById(`${secId}-content`);\n      const icon = document.getElementById(`${secId}-icon`);\n      const isClosed = content.classList.contains('accordion-closed');\n\n      if (isClosed) {\n        content.classList.remove('accordion-closed');\n        content.classList.add('accordion-open');\n        if (icon) {\n          icon.textContent = '▲';\n          icon.classList.add('bg-indigo-600', 'text-white');\n        }\n        section.scrollIntoView({ behavior: 'smooth', block: 'start' });\n      } else {\n        content.classList.remove('accordion-open');\n        content.classList.add('accordion-closed');\n        if (icon) {\n          icon.textContent = '▼';\n          icon.classList.remove('bg-indigo-600', 'text-white');\n        }\n      }\n    }\n\n    function expandAllSections() {\n      ['sec-1', 'sec-2', 'sec-3', 'sec-4', 'sec-5', 'sec-6'].forEach(secId => {\n        const content = document.getElementById(`${secId}-content`);\n        const icon = document.getElementById(`${secId}-icon`);\n        content.classList.remove('accordion-closed');\n        content.classList.add('accordion-open');\n        if (icon) {\n          icon.textContent = '▲';\n          icon.classList.add('bg-indigo-600', 'text-white');\n        }\n      });\n    }\n\n    function collapseAllSections() {\n      ['sec-1', 'sec-2', 'sec-3', 'sec-4', 'sec-5', 'sec-6'].forEach(secId => {\n        const content = document.getElementById(`${secId}-content`);\n        const icon = document.getElementById(`${secId}-icon`);\n        content.classList.remove('accordion-open');\n        content.classList.add('accordion-closed');\n        if (icon) {\n          icon.textContent = '▼';\n          icon.classList.remove('bg-indigo-600', 'text-white');\n        }\n      });\n    }\n\n    function togglePainSolution(solId) {\n      const sol = document.getElementById(solId);\n      if (sol.classList.contains('hidden')) {\n        sol.classList.remove('hidden');\n      } else {\n        sol.classList.add('hidden');\n      }\n    }\n\n    function openTrialModal() {\n      document.getElementById('trial-modal').classList.remove('hidden');\n      document.getElementById('trial-modal').classList.add('flex');\n    }\n\n    function closeTrialModal() {\n      document.getElementById('trial-modal').classList.remove('flex');\n      document.getElementById('trial-modal').classList.add('hidden');\n    }\n\n    function submitTrialForm(e) {\n      e.preventDefault();\n      alert('感謝您的申請！迪凱科技 AHASoft 專員已收到您的資訊，將於 24 小時內專人與您聯繫安排 30 天 Enterprise 企業試用環境！');\n      closeTrialModal();\n    }\n  </script>\n</body>\n</html>\n","Description":"同步更新 public/index.html：加入 HTML 防快取標籤、微型強刷新按鈕與 JS forceHardRefresh() 函數。","Overwrite":true,"TargetFile":"C:\\Users\\User\\.gemini\\antigravity\\brain\\cebfe850-edaa-4bde-aa18-447bd515eeb1\\scratch\\JetBrains-AI-Assistant-Portal\\public\\index.html","toolAction":"Updating public/index.html with anti-caching meta and hard refresh button","toolSummary":"Update public/index.html with anti-cachin