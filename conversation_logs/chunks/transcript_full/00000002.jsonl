-800/80 px-6 py-3.5 flex items-center justify-between backdrop-blur-md z-30 sticky top-0\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center font-black text-white text-base shadow-lg shadow-indigo-500/20\">\n        JB\n      </div>\n      <div>\n        <h1 class=\"font-bold text-sm tracking-wide text-white flex items-center gap-2\">\n          JetBrains AI Assistant 企業級 Pitch 簡報\n          <span class=\"text-[10px] px-2 py-0.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 font-medium\">台灣官方代理 迪凱科技</span>\n        </h1>\n      </div>\n    </div>\n    \n    <div class=\"flex items-center gap-4\">\n      <div class=\"text-xs text-slate-400 font-medium hidden sm:block\">\n        <span id=\"slide-counter\" class=\"text-indigo-400 font-bold text-sm\">1</span> / <span id=\"total-slides\">15</span> 頁\n      </div>\n      \n      <!-- Slide Selector Dropdown -->\n      <select id=\"slide-select\" onchange=\"goToSlide(parseInt(this.value))\" class=\"bg-slate-800 border border-slate-700 text-xs text-slate-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-indigo-500\">\n        <option value=\"0\">1. 封面 Slide</option>\n        <option value=\"1\">2. 簡報引言 Executive Summary</option>\n        <option value=\"2\">3. 簡報目錄 Table of Contents</option>\n        <option value=\"3\">4. 高風控市場驗證 Market Verification</option>\n        <option value=\"4\">5. 對比圖表 CLI vs. Platform</option>\n        <option value=\"5\">6. 靜態代碼分析 (PSI) 杜絕幻覺</option>\n        <option value=\"6\">7. 實戰 Smart Debugging 協作</option>\n        <option value=\"7\">8. 多模型切換 (Claude/GPT/Gemini)</option>\n        <option value=\"8\">9. Central Console 財務用量控管</option>\n        <option value=\"9\">10. 🛡️ 資安一：控制/數據面分離</option>\n        <option value=\"10\">11. 🛡️ 資安二：零訓練與 30 天銷毀</option>\n        <option value=\"11\">12. 🛡️ 資安三：AI Enterprise 部署</option>\n        <option value=\"12\">13. 迪凱業務真心話：散買 8 大噩夢</option>\n        <option value=\"13\">14. 迪凱科技 6 大在地專屬服務</option>\n        <option value=\"14\">15. 結語 & 30天 Enterprise Trial</option>\n      </select>\n\n      <a href=\"https://trust-center.jetbrains.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hidden lg:flex items-center gap-1.5 text-xs bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 px-3 py-1.5 rounded-lg transition-all font-medium\">\n        <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\"></path></svg>\n        Trust Center 背書\n      </a>\n    </div>\n  </header>\n\n  <!-- Main Slide Viewport Container -->\n  <main class=\"flex-1 max-w-7xl w-full mx-auto p-4 md:p-8 flex items-center justify-center relative min-h-[620px]\">\n\n    <!-- SLIDE 1: Cover -->\n    <div class=\"slide slide-active flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl backdrop-blur-sm\">\n      <div class=\"absolute -right-20 -top-20 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none\"></div>\n      <div class=\"absolute -left-20 -bottom-20 w-96 h-96 bg-purple-600/15 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div class=\"z-10\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-6\">\n          <span class=\"w-2 h-2 rounded-full bg-indigo-400 animate-pulse\"></span>\n          Enterprise Pitch Presentation\n        </div>\n        \n        <h1 class=\"text-3xl md:text-5xl font-black tracking-tight text-white leading-tight mb-4\">\n          JetBrains AI Assistant<br/>\n          <span class=\"bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent\">\n            企業級開發助手簡報\n          </span>\n        </h1>\n        \n        <p class=\"text-slate-300 text-lg max-w-2xl font-normal leading-relaxed mb-8\">\n          結合強大 IDE 靜態代碼分析與多模型 AI 生態，為高風控企業打造安全、高效、透明且防範廠商鎖定的下一代開發體驗。\n        </p>\n      </div>\n\n      <div class=\"z-10 pt-6 border-t border-slate-800/80 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div class=\"text-xs text-slate-400 font-medium\">主講團隊</div>\n          <div class=\"text-sm font-bold text-white flex items-center gap-2\">\n            迪凱科技 DeKai Technology \n            <span class=\"text-slate-400 font-normal\">| JetBrains 台灣官方代理商</span>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-3\">\n          <div class=\"px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-xs text-slate-300 font-medium\">\n            受眾：CTO / IT 處長 / CISO / 採購主管\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 2: Executive Summary -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Executive Summary</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-6\">簡報引言：現代企業 AI 採購的三大痛點與解法</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-5 mb-6\">\n          <div class=\"bg-red-950/20 border border-red-900/40 rounded-xl p-5\">\n            <div class=\"text-red-400 text-xs font-bold uppercase tracking-wider mb-2\">痛點 1：資安漏洞</div>\n            <h3 class=\"text-white font-bold text-base mb-2\">工具碎片化與影子 IT</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              員工私下採購 Copilot, ChatGPT, Claude，公司難以稽核程式碼傳輸路徑，資安邊界完全失控。\n            </p>\n          </div>\n\n          <div class=\"bg-amber-950/20 border border-amber-900/40 rounded-xl p-5\">\n            <div class=\"text-amber-400 text-xs font-bold uppercase tracking-wider mb-2\">痛點 2：廠商鎖定</div>\n            <h3 class=\"text-white font-bold text-base mb-2\">押寶單一模型風險</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              AI 模型三個月大翻檔。綁定單一 CLI 工具（如 Claude Code），未來切換其他強大模型代價高昂。\n            </p>\n          </div>\n\n          <div class=\"bg-purple-950/20 border border-purple-900/40 rounded-xl p-5\">\n            <div class=\"text-purple-400 text-xs font-bold uppercase tracking-wider mb-2\">痛點 3：請購繁瑣</div>\n            <h3 class=\"text-white font-bold text-base mb-2\">財務與帳務混亂</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              每個月處理大量分散的海外信用卡帳單與比價請購流程，缺乏一站式企業級配額管理。\n            </p>\n          </div>\n        </div>\n\n        <div class=\"bg-indigo-950/30 border border-indigo-500/30 rounded-xl p-5 flex items-center gap-4\">\n          <div class=\"w-10 h-10 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 font-bold text-lg\">\n            ✓\n          </div>\n          <div>\n            <h4 class=\"text-white font-bold text-sm\">JetBrains + 迪凱科技在地解法</h4>\n            <p class=\"text-slate-300 text-xs leading-relaxed\">\n              IDE 原生防幻覺 + 多模型開放平台 + Central 控制/數據面分離 + 迪凱在地發票與無帳密安全開通。\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 3: Table of Contents -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10 w-full\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Agenda</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-6\">簡報目錄 (Table of Contents)</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div class=\"bg-slate-800/50 border border-slate-700/60 rounded-xl p-4 flex items-start gap-3\">\n            <span class=\"w-7 h-7 rounded-lg bg-indigo-500/20 text-indigo-300 font-bold text-xs flex items-center justify-center shrink-0\">01</span>\n            <div>\n              <h3 class=\"text-white font-bold text-sm\">第一段：產品簡介</h3>\n              <p class=\"text-slate-400 text-xs\">JetBrains AI Assistant 是什麼？高風控市場驗證與比較</p>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-800/50 border border-slate-700/60 rounded-xl p-4 flex items-start gap-3\">\n            <span class=\"w-7 h-7 rounded-lg bg-indigo-500/20 text-indigo-300 font-bold text-xs flex items-center justify-center shrink-0\">02</span>\n            <div>\n              <h3 class=\"text-white font-bold text-sm\">第二段：產品優勢</h3>\n              <p class=\"text-slate-400 text-xs\">IDE 靜態代碼分析 (PSI) + 上下文感知，杜絕 AI 幻覺</p>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-800/50 border border-slate-700/60 rounded-xl p-4 flex items-start gap-3\">\n            <span class=\"w-7 h-7 rounded-lg bg-indigo-500/20 text-indigo-300 font-bold text-xs flex items-center justify-center shrink-0\">03</span>\n            <div>\n              <h3 class=\"text-white font-bold text-sm\">第三段：計費與模型優勢</h3>\n              <p class=\"text-slate-400 text-xs\">不綁定單一 LLM，同一平台自由切換你愛的 AI Agent</p>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-800/50 border border-slate-700/60 rounded-xl p-4 flex items-start gap-3\">\n            <span class=\"w-7 h-7 rounded-lg bg-indigo-500/20 text-indigo-300 font-bold text-xs flex items-center justify-center shrink-0\">04</span>\n            <div>\n              <h3 class=\"text-white font-bold text-sm\">第四段：帳務管理優勢</h3>\n              <p class=\"text-slate-400 text-xs\">JetBrains Central Console 一站式用量紀錄與財務解法</p>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-800/50 border border-slate-700/60 rounded-xl p-4 flex items-start gap-3\">\n            <span class=\"w-7 h-7 rounded-lg bg-indigo-500/20 text-indigo-300 font-bold text-xs flex items-center justify-center shrink-0\">05</span>\n            <div>\n              <h3 class=\"text-white font-bold text-sm\">第五段：安全可信度聲明</h3>\n              <p class=\"text-slate-400 text-xs\">數據隱私、零訓練承諾、控制面/數據面分離驗證</p>\n            </div>\n          </div>\n\n          <div class=\"bg-slate-800/50 border border-slate-700/60 rounded-xl p-4 flex items-start gap-3\">\n            <span class=\"w-7 h-7 rounded-lg bg-indigo-500/20 text-indigo-300 font-bold text-xs flex items-center justify-center shrink-0\">06</span>\n            <div>\n              <h3 class=\"text-white font-bold text-sm\">第六段：台灣代理商服務 & 結語</h3>\n              <p class=\"text-slate-400 text-xs\">迪凱科技 6 大在地服務值與 30 天 Enterprise Trial</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 4: Section 1 - Market Verification -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 1: Product Intro</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">經過高風控市場長期驗證的 IDE 巨頭</h2>\n        <p class=\"text-slate-300 text-sm mb-6\">為什麼全台灣與全球頂級金融、半導體、證券企業選擇 JetBrains？</p>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-5 mb-6\">\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <div class=\"text-indigo-400 text-2xl font-black mb-1\">90%+</div>\n            <h3 class=\"text-white font-bold text-sm mb-2\">金融與證券巨頭標配</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              IntelliJ IDEA, PyCharm, Rider 早已通過台灣各大金控與券商最嚴苛的資安審查。\n            </p>\n          </div>\n\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <div class=\"text-purple-400 text-2xl font-black mb-1\">20+ 年</div>\n            <h3 class=\"text-white font-bold text-sm mb-2\">工具研發經驗積澱</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              非臨時組裝的 Web 編輯器或外掛，具備全球最頂尖的抽象語法樹 (PSI) 靜態分析能力。\n            </p>\n          </div>\n\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <div class=\"text-pink-400 text-2xl font-black mb-1\">100%</div>\n            <h3 class=\"text-white font-bold text-sm mb-2\">企業級資安與合規性</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              提供 SOC 2 Type II 認證、GDPR 合規、控制面/數據面分離及離線 Enterprise 部署模式。\n            </p>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/40 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between\">\n          <span class=\"text-xs text-slate-300 font-medium\">JetBrains 官方原廠背書文件：</span>\n          <div class=\"flex items-center gap-3\">\n            <a href=\"https://www.jetbrains.com/enterprise/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">JetBrains Enterprise Solutions 🔗</a>\n            <a href=\"https://www.jetbrains.com/case-studies/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">Customer Case Studies 🔗</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 5: Section 1 - Feature Comparison Table -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10 w-full\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 1: Feature Comparison</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">產品對比：點狀 CLI / 外掛 vs. JetBrains AI 平台</h2>\n\n        <div class=\"overflow-x-auto mb-4\">\n          <table class=\"w-full text-left text-xs border-collapse\">\n            <thead>\n              <tr class=\"bg-slate-800/80 border-b border-slate-700 text-slate-300\">\n                <th class=\"p-3 font-bold\">比較維度</th>\n                <th class=\"p-3 font-bold text-amber-300\">輕量外掛 / 獨立 CLI (如 Claude Code)</th>\n                <th class=\"p-3 font-bold text-indigo-300\">JetBrains AI Assistant 平台</th>\n              </tr>\n            </thead>\n            <tbody class=\"divide-y divide-slate-800/60 text-slate-300\">\n              <tr>\n                <td class=\"p-3 font-semibold text-white\">專案上下文理解</td>\n                <td class=\"p-3 text-slate-400\">僅文字檔檢索，易遺漏跨檔案繼承與依賴</td>\n                <td class=\"p-3 font-semibold text-indigo-300\">PSI 抽象語法樹 + 全專案符號索引</td>\n              </tr>\n              <tr class=\"bg-slate-900/40\">\n                <td class=\"p-3 font-semibold text-white\">介面互動與審查</td>\n                <td class=\"p-3 text-slate-400\">純命令行 (CLI)，需手動在編輯器與 Terminal 切換</td>\n                <td class=\"p-3 font-semibold text-indigo-300\">IDE 原生二元 Diff 審查、Gutter 快速替換</td>\n              </tr>\n              <tr>\n                <td class=\"p-3 font-semibold text-white\">異常調試能力</td>\n                <td class=\"p-3 text-slate-400\">需手動複製貼上 Stack Trace 報錯訊息</td>\n                <td class=\"p-3 font-semibold text-indigo-300\">Smart Debugging 結合 Debugger 直連診斷</td>\n              </tr>\n              <tr class=\"bg-slate-900/40\">\n                <td class=\"p-3 font-semibold text-white\">模型選擇彈性</td>\n                <td class=\"p-3 text-slate-400\">綁定單一模型供應商 (如僅限 Anthropic)</td>\n                <td class=\"p-3 font-semibold text-indigo-300\">內建 Claude 3.5 / GPT-4o / Gemini 自由切換</td>\n              </tr>\n              <tr>\n                <td class=\"p-3 font-semibold text-white\">企業中央管理</td>\n                <td class=\"p-3 text-slate-400\">缺乏集中控制台，易形成資安與費用破口</td>\n                <td class=\"p-3 font-semibold text-indigo-300\">JetBrains Central 中央配額與資安政策控管</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"text-right\">\n          <a href=\"https://www.jetbrains.com/ai/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline font-medium\">查看 JetBrains AI Assistant 官方功能規格 🔗</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 6: Section 2 - Static Analysis (PSI) Anti-Hallucination -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 2: Technical Edge</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">靜態代碼分析 (PSI) + 情境感知：杜絕 AI 幻覺</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-6\">\n          <div class=\"bg-slate-800/50 border border-slate-700 rounded-xl p-5\">\n            <h3 class=\"text-amber-400 font-bold text-sm mb-2 flex items-center gap-2\">\n              <span class=\"w-2 h-2 rounded-full bg-amber-400\"></span> 傳統 Agent Coding 的致命痛點\n            </h3>\n            <ul class=\"text-slate-300 text-xs space-y-2.5\">\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-amber-400\">✕</span>\n                <span><strong>AI 幻覺 (Hallucination)</strong>：生成不存在的 API 方法或錯誤傳參。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-amber-400\">✕</span>\n                <span><strong>上下文丟失 (Context Loss)</strong>：專案過大時，丟失型別繼承與深層調用鏈。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-amber-400\">✕</span>\n                <span><strong>破壞專案架構</strong>：產生不合規範的語法，導致編譯直接失敗。</span>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"bg-indigo-950/30 border border-indigo-500/30 rounded-xl p-5\">\n            <h3 class=\"text-indigo-300 font-bold text-sm mb-2 flex items-center gap-2\">\n              <span class=\"w-2 h-2 rounded-full bg-indigo-400\"></span> JetBrains 獨家靜態分析解法\n            </h3>\n            <ul class=\"text-slate-200 text-xs space-y-2.5\">\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-indigo-400 font-bold\">✓</span>\n                <span><strong>PSI 抽象語法樹引擎</strong>：AI 輸出前先經由 IDE 完成靜態型別與語法預檢。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-indigo-400 font-bold\">✓</span>\n                <span><strong>精準語意情境感知</strong>：完整掌握 Symbol Index，精確理解方法調用關係。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-indigo-400 font-bold\">✓</span>\n                <span><strong>視覺化二元 Diff 審查</strong>：所有變更以直觀 Diff 呈現，控制權 100% 留給工程師。</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/40 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between\">\n          <span class=\"text-xs text-slate-300 font-medium\">原廠說明：</span>\n          <div class=\"flex items-center gap-3\">\n            <a href=\"https://www.jetbrains.com/help/idea/code-inspection.html\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">JetBrains Code Inspection Engine 🔗</a>\n            <a href=\"https://www.jetbrains.com/help/idea/ai-assistant.html\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">How AI Uses Context 🔗</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 7: Section 2 - Workflow & Smart Debugging -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 2: Developer Flow</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">全流程協作：從寫代碼到 Smart Debugging</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-5 mb-6\">\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <div class=\"w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-300 font-bold flex items-center justify-center mb-3\">1</div>\n            <h3 class=\"text-white font-bold text-sm mb-2\">Inline & Gutter 操作</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              程式碼行首 (Gutter) 直接點擊召喚 AI，在編輯器內自動生成、補全與優化演算法。\n            </p>\n          </div>\n\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <div class=\"w-8 h-8 rounded-lg bg-purple-500/20 text-purple-300 font-bold flex items-center justify-center mb-3\">2</div>\n            <h3 class=\"text-white font-bold text-sm mb-2\">Smart Debugging 診斷</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              直連 IDE Debugger，當編譯或執行丟出 Exception 時，自動分析 Stack Trace 並提供修補建議。\n            </p>\n          </div>\n\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <div class=\"w-8 h-8 rounded-lg bg-pink-500/20 text-pink-300 font-bold flex items-center justify-center mb-3\">3</div>\n            <h3 class=\"text-white font-bold text-sm mb-2\">Git Commit & Test 自動化</h3>\n            <p class=\"text-slate-400 text-xs leading-relaxed\">\n              一鍵自動分析代碼變更生成規範 Commit Message，並為函數自動生成單元測試案例。\n            </p>\n          </div>\n        </div>\n\n        <div class=\"text-right\">\n          <a href=\"https://www.jetbrains.com/help/idea/ai-assistant-smart-chat.html\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline font-medium\">參閱 Smart Debugging 官方文檔 🔗</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 8: Section 3 - Multi-Model Freedom -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 3: Model Freedom</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">不綁定單一 LLM，同一平台自由切換你愛的 Agent</h2>\n        \n        <div class=\"bg-indigo-950/30 border border-indigo-500/30 rounded-xl p-6 mb-6\">\n          <h3 class=\"text-white font-bold text-base mb-2\">客戶常問：「我們習慣用 Claude 3.5 Sonnet，換成 JetBrains 是不是要放棄？」</h3>\n          <p class=\"text-indigo-200 text-sm font-semibold mb-4\">\n            解答：完全不需要！JetBrains AI Assistant 是開放平台，已整合全球最強大模型！\n          </p>\n\n          <div class=\"grid grid-cols-2 md:grid-cols-4 gap-3 text-center\">\n            <div class=\"bg-slate-900/80 border border-slate-700/80 rounded-lg p-3\">\n              <div class=\"text-amber-400 font-bold text-xs mb-1\">Anthropic</div>\n              <div class=\"text-white font-black text-sm\">Claude 3.5 Sonnet</div>\n            </div>\n\n            <div class=\"bg-slate-900/80 border border-slate-700/80 rounded-lg p-3\">\n              <div class=\"text-emerald-400 font-bold text-xs mb-1\">OpenAI</div>\n              <div class=\"text-white font-black text-sm\">GPT-4o / GPT-4</div>\n            </div>\n\n            <div class=\"bg-slate-900/80 border border-slate-700/80 rounded-lg p-3\">\n              <div class=\"text-sky-400 font-bold text-xs mb-1\">Google</div>\n              <div class=\"text-white font-black text-sm\">Gemini 1.5 Pro</div>\n            </div>\n\n            <div class=\"bg-slate-900/80 border border-slate-700/80 rounded-lg p-3\">\n              <div class=\"text-purple-400 font-bold text-xs mb-1\">JetBrains</div>\n              <div class=\"text-white font-black text-sm\">Mellum (自研)</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/40 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between\">\n          <span class=\"text-xs text-slate-300 font-medium\">原廠條款背書：</span>\n          <div class=\"flex items-center gap-3\">\n            <a href=\"https://www.jetbrains.com/ai/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">JetBrains Supported LLMs 🔗</a>\n            <a href=\"https://www.jetbrains.com/legal/docs/terms/jetbrains-ai/service-agreement/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">AI Service Agreement 🔗</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 9: Section 4 - Central Console Governance -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 4: Central Console</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">JetBrains Central Console：財務與 IT 的中央管理利器</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-6\">\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <h3 class=\"text-white font-bold text-sm mb-3\">一站式中央帳務與配額儀表板</h3>\n            <ul class=\"text-slate-300 text-xs space-y-2.5\">\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-indigo-400 font-bold\">✓</span>\n                <span><strong>AI Credits 統一積分機制</strong>：全公司用量、剩餘額度一目瞭然。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-indigo-400 font-bold\">✓</span>\n                <span><strong>解救財務繁瑣流程</strong>：再也不用每個月處理大量分散的海外信用卡帳單。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-indigo-400 font-bold\">✓</span>\n                <span><strong>透明用量審計</strong>：提供完整的使用量統計報表，AI 投資可精確計量。</span>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-5\">\n            <h3 class=\"text-white font-bold text-sm mb-3\">精準組織權限控管 (Quota Allocation)</h3>\n            <ul class=\"text-slate-300 text-xs space-y-2.5\">\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-purple-400 font-bold\">✓</span>\n                <span><strong>部門用量設定</strong>：針對前端、後端、QA 分配 AI 點數，防止超用。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-purple-400 font-bold\">✓</span>\n                <span><strong>人員動態授權</strong>：隨時收回或派發 AI 權限，無縫交接。</span>\n              </li>\n              <li class=\"flex items-start gap-2\">\n                <span class=\"text-purple-400 font-bold\">✓</span>\n                <span><strong>控制面完全集中</strong>：統一集中管理所有 IDE 授權與 AI 點數。</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/40 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between\">\n          <span class=\"text-xs text-slate-300 font-medium\">原廠文件背書：</span>\n          <div class=\"flex items-center gap-3\">\n            <a href=\"https://www.jetbrains.com/help/licenses/jetbrains-account.html\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">JetBrains Account Console Docs 🔗</a>\n            <a href=\"https://www.jetbrains.com/legal/docs/terms/jetbrains-ai/credits/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">AI Credits Terms 🔗</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 10: Section 5 - Security Pillar 1 -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 5: Trust Architecture</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">🛡️ 安全聲明一：控制面與數據面嚴格分離</h2>\n        \n        <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-6 mb-6\">\n          <h3 class=\"text-white font-bold text-base mb-4 flex items-center gap-2\">\n            <span class=\"w-3 h-3 rounded-full bg-emerald-400\"></span> 雙層防護架構邏輯 (Separation of Planes)\n          </h3>\n\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div class=\"bg-slate-900/80 border border-slate-700/80 rounded-xl p-4\">\n              <h4 class=\"text-indigo-300 font-bold text-sm mb-2\">控制面 (Control Plane)</h4>\n              <p class=\"text-slate-300 text-xs leading-relaxed\">\n                由 <strong>JetBrains Central</strong> 處理：僅流轉 License 驗證、計費點數與權限政策。<br/>\n                <span class=\"text-indigo-400 font-semibold\">★ 絕不儲存、也永遠無法存取貴公司的核心程式碼！</span>\n              </p>\n            </div>\n\n            <div class=\"bg-slate-900/80 border border-slate-700/80 rounded-xl p-4\">\n              <h4 class=\"text-purple-300 font-bold text-sm mb-2\">數據面 (Data Plane)</h4>\n              <p class=\"text-slate-300 text-xs leading-relaxed\">\n                由 <strong>開發者端點 (IDE) ➔ LLM 傳輸</strong>：數據僅在端點與 AI 模型間以加密通道傳送。<br/>\n                <span class=\"text-purple-400 font-semibold\">★ 遵循嚴格資安通訊協議與零訓練條款！</span>\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/40 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between\">\n          <span class=\"text-xs text-slate-300 font-medium\">JetBrains 官方 Trust Center 驗證：</span>\n          <a href=\"https://trust-center.jetbrains.com/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline font-bold\">https://trust-center.jetbrains.com/ 🔗</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 11: Section 5 - Security Pillar 2 -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 5: Data Privacy</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">🛡️ 安全聲明二：鐵一般的「零訓練承諾」與 30 天銷毀</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5 mb-6\">\n          <div class=\"bg-emerald-950/20 border border-emerald-500/30 rounded-xl p-5\">\n            <h3 class=\"text-emerald-400 font-bold text-sm mb-2 flex items-center gap-2\">\n              <span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span> 100% No-Training Policy\n            </h3>\n            <p class=\"text-slate-300 text-xs leading-relaxed mb-3\">\n              JetBrains 官方法務條款聲明：<strong>絕對不會使用客戶的程式碼、Prompt 提示詞或 AI 輸出結果來訓練任何公共 LLM 模型</strong>。\n            </p>\n            <p class=\"text-slate-400 text-xs\">\n              所有簽約的第三方 LLM 供應商（Anthropic, OpenAI, Google）均簽署嚴格企業協議，遵循相同零訓練標準。\n            </p>\n          </div>\n\n          <div class=\"bg-sky-950/20 border border-sky-500/30 rounded-xl p-5\">\n            <h3 class=\"text-sky-400 font-bold text-sm mb-2 flex items-center gap-2\">\n              <span class=\"w-2 h-2 rounded-full bg-sky-400\"></span> 數據 30 天強制銷毀 & SOC 2\n            </h3>\n            <p class=\"text-slate-300 text-xs leading-relaxed mb-3\">\n              所有用於處理任務的短暫 Session 暫存數據，最長於 <strong>30 天內強制自動銷毀</strong>。\n            </p>\n            <p class=\"text-slate-400 text-xs\">\n              基礎設施通過國際 <strong>SOC 2 Type II</strong> 認證，全面符合歐洲 <strong>GDPR</strong> 數據保護規範。\n            </p>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/40 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between\">\n          <span class=\"text-xs text-slate-300 font-medium\">JetBrains 原廠法務與資安門戶：</span>\n          <div class=\"flex items-center gap-3\">\n            <a href=\"https://trust-center.jetbrains.com/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">JetBrains Trust Center 🔗</a>\n            <a href=\"https://www.jetbrains.com/legal/docs/privacy/privacy/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">Privacy Notice 🔗</a>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 12: Section 5 - Security Pillar 3 -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 5: AI Enterprise</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">🛡️ 安全聲明三：極致資安選項 AI Enterprise</h2>\n        \n        <div class=\"bg-slate-800/60 border border-slate-700 rounded-xl p-6 mb-6\">\n          <h3 class=\"text-white font-bold text-base mb-3\">針對金融核心、半導體核心研發與國防專案的選配方案</h3>\n\n          <div class=\"space-y-4 text-xs\">\n            <div class=\"flex items-start gap-3 bg-slate-900/60 p-3.5 rounded-lg border border-slate-700/60\">\n              <span class=\"text-indigo-400 font-bold text-sm\">01</span>\n              <div>\n                <strong class=\"text-white font-semibold\">私有地 (On-Premises) 模型部署</strong>\n                <p class=\"text-slate-400 mt-1\">支援在企業自有機房或私有雲內部署 LLM，所有 AI 推理完全在內網閉環完成。</p>\n              </div>\n            </div>\n\n            <div class=\"flex items-start gap-3 bg-slate-900/60 p-3.5 rounded-lg border border-slate-700/60\">\n              <span class=\"text-indigo-400 font-bold text-sm\">02</span>\n              <div>\n                <strong class=\"text-white font-semibold\">完全離線模式 (Offline Mode)</strong>\n                <p class=\"text-slate-400 mt-1\">IDE 提供強制離線開關，阻斷所有外網模型調用，符合最嚴苛防洩密規範。</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/40 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between\">\n          <span class=\"text-xs text-slate-300 font-medium\">JetBrains 原廠 Enterprise 方案背書：</span>\n          <a href=\"https://www.jetbrains.com/ai/enterprise/\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline\">JetBrains AI Enterprise 🔗</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 13: Section 6 - DeKai Sales Pain Points -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 6: Local Partner Value</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">業務員真心話：散買代購 LLM 的 8 大企業噩夢</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs mb-6\">\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>必須向客戶索取帳號密碼</strong>：產生巨大資安與權限外洩風險。</span>\n          </div>\n\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>原廠最低採購數量限制</strong>：缺乏彈性，浪費企業預算。</span>\n          </div>\n\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>帳務與發票問題求助無門</strong>：海外客服回應緩慢，影響核銷。</span>\n          </div>\n\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>增購/充值管道不明確</strong>：計價與外幣匯率隨風搖擺。</span>\n          </div>\n\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>缺乏中央管理 Console</strong>：IT 無法掌控員工實際用量。</span>\n          </div>\n\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>團隊超用遭鎖定</strong>：影響專案開發進度無所適從。</span>\n          </div>\n\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>每天出新 AI 工具</strong>：同仁分散要求開立請購單。</span>\n          </div>\n\n          <div class=\"bg-red-950/20 border border-red-900/30 p-3 rounded-lg flex items-start gap-2\">\n            <span class=\"text-red-400 font-bold\">✕</span>\n            <span class=\"text-slate-300\"><strong>原廠政策朝令夕改</strong>：企業缺乏長期遵循的使用標準。</span>\n          </div>\n        </div>\n\n        <div class=\"bg-slate-800/50 p-3 rounded-xl border border-slate-700 text-center text-xs text-slate-300 font-semibold\">\n          說白了，散買只是「代購」，無法解決企業長期的工具混亂與資安風險。\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 14: Section 6 - DeKai Local Service Value -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10\">\n        <div class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest mb-2\">Section 6: DeKai Solutions</div>\n        <h2 class=\"text-2xl md:text-3xl font-extrabold text-white mb-4\">迪凱科技 (DeKai) 提供的 6 大在地專屬服務</h2>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs mb-6\">\n          <div class=\"bg-emerald-950/20 border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3\">\n            <div class=\"w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0\">1</div>\n            <div>\n              <strong class=\"text-white font-semibold\">完全無需提供帳號密碼</strong>\n              <p class=\"text-slate-400 mt-1\">直接針對貴公司 Central Console 進行合法授權與 Credits 充值。</p>\n            </div>\n          </div>\n\n          <div class=\"bg-emerald-950/20 border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3\">\n            <div class=\"w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0\">2</div>\n            <div>\n              <strong class=\"text-white font-semibold\">零最低採購門檻限制</strong>\n              <p class=\"text-slate-400 mt-1\">AI Credits 採彈性充值（10 USD 起算），用多少充多少，絕不浪費預算。</p>\n            </div>\n          </div>\n\n          <div class=\"bg-emerald-950/20 border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3\">\n            <div class=\"w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0\">3</div>\n            <div>\n              <strong class=\"text-white font-semibold\">台灣在地單一窗口服務</strong>\n              <p class=\"text-slate-400 mt-1\">快速處理帳務與授權問題，無需苦苦等待海外客服回覆。</p>\n            </div>\n          </div>\n\n          <div class=\"bg-emerald-950/20 border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3\">\n            <div class=\"w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0\">4</div>\n            <div>\n              <strong class=\"text-white font-semibold\">合規台幣發票與價格透明</strong>\n              <p class=\"text-slate-400 mt-1\">提供標準台灣企業發票，計費透明，並有專員提供採購建議。</p>\n            </div>\n          </div>\n\n          <div class=\"bg-emerald-950/20 border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3\">\n            <div class=\"w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0\">5</div>\n            <div>\n              <strong class=\"text-white font-semibold\">Central Console 部署協助</strong>\n              <p class=\"text-slate-400 mt-1\">協助 IT 部門規劃成員配額、授權分配與資安政策。</p>\n            </div>\n          </div>\n\n          <div class=\"bg-emerald-950/20 border border-emerald-500/30 p-4 rounded-xl flex items-start gap-3\">\n            <div class=\"w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold shrink-0\">6</div>\n            <div>\n              <strong class=\"text-white font-semibold\">單一平台涵蓋多元 LLM</strong>\n              <p class=\"text-slate-400 mt-1\">徹底解決「今天買這家、明天買那家」的頭痛問題。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- SLIDE 15: Conclusion & Call to Action -->\n    <div class=\"slide hidden flex-col justify-between w-full h-full min-h-[540px] bg-slate-900/60 border border-slate-800 rounded-2xl p-8 md:p-12 relative overflow-hidden shadow-2xl\">\n      <div class=\"z-10 text-center max-w-3xl mx-auto my-auto\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-6\">\n          Conclusion & Next Steps\n        </div>\n\n        <h2 class=\"text-2xl md:text-4xl font-black text-white leading-tight mb-6\">\n          「你可以不接受，但是我建議你試試看！<br/>\n          <span class=\"bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent\">\n            在現今這個年代，試試看往往不吃虧。」\n          </span>\n        </h2>\n\n        <p class=\"text-slate-300 text-sm leading-relaxed mb-8\">\n          選擇一個正確的平台與可靠的台灣在地夥伴，能讓貴公司少走三年彎路。<br/>\n          迪凱科技誠摯邀請貴團隊開啟 <strong class=\"text-white\">JetBrains AI 30 天免責企業試用</strong>！\n        </p>\n\n        <div class=\"flex flex-col sm:flex-row items-center justify-center gap-4\">\n          <a href=\"https://trust-center.jetbrains.com/\" target=\"_blank\" class=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-lg shadow-indigo-600/30 transition-all\">\n            查驗 JetBrains 官方 Trust Center 🔗\n          </a>\n          <div class=\"text-xs text-slate-400 font-medium\">\n            聯繫迪凱科技專屬業務專員，24 小時內協助開通試用環境\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </main>\n\n  <!-- Presentation Control Bar (Footer) -->\n  <footer class=\"w-full bg-slate-900/90 border-t border-slate-800/80 px-6 py-3 flex items-center justify-between z-30 sticky bottom-0\">\n    <div class=\"flex items-center gap-2 text-xs text-slate-400\">\n      <span class=\"hidden md:inline\">提示：可以使用</span>\n      <kbd class=\"px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300 font-mono text-[10px]\">←</kbd>\n      <kbd class=\"px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300 font-mono text-[10px]\">→</kbd>\n      <span class=\"hidden md:inline\">方向鍵或空白鍵切換投影片</span>\n    </div>\n\n    <!-- Progress Bar -->\n    <div class=\"w-48 md:w-96 bg-slate-800 h-2 rounded-full overflow-hidden border border-slate-700/50\">\n      <div id=\"progress-bar\" class=\"bg-gradient-to-r from-indigo-500 to-pink-500 h-full w-[6.66%] transition-all duration-300\"></div>\n    </div>\n\n    <!-- Nav Buttons -->\n    <div class=\"flex items-center gap-2\">\n      <button onclick=\"prevSlide()\" class=\"px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-white transition-all\">\n        上一頁\n      </button>\n      <button onclick=\"nextSlide()\" class=\"px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-xs font-semibold text-white shadow-md shadow-indigo-600/20 transition-all\">\n        下一頁\n      </button>\n    </div>\n  </footer>\n\n  <!-- Vanilla JavaScript Navigation Controller -->\n  <script>\n    let currentSlide = 0;\n    const slides = document.querySelectorAll('.slide');\n    const totalSlides = slides.length;\n    const counterEl = document.getElementById('slide-counter');\n    const progressBar = document.getElementById('progress-bar');\n    const slideSelect = document.getElementById('slide-select');\n\n    function updateSlide() {\n      slides.forEach((slide, idx) => {\n        if (idx === currentSlide) {\n          slide.classList.add('slide-active');\n          slide.classList.remove('hidden');\n        } else {\n          slide.classList.remove('slide-active');\n          slide.classList.add('hidden');\n        }\n      });\n\n      counterEl.textContent = currentSlide + 1;\n      slideSelect.value = currentSlide;\n      const progressPercent = ((currentSlide + 1) / totalSlides) * 100;\n      progressBar.style.width = `${progressPercent}%`;\n    }\n\n    function nextSlide() {\n      if (currentSlide < totalSlides - 1) {\n        currentSlide++;\n        updateSlide();\n      }\n    }\n\n    function prevSlide() {\n      if (currentSlide > 0) {\n        currentSlide--;\n        updateSlide();\n      }\n    }\n\n    function goToSlide(idx) {\n      if (idx >= 0 && idx < totalSlides) {\n        currentSlide = idx;\n        updateSlide();\n      }\n    }\n\n    // Keyboard Shortcuts\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowRight' || e.key === 'Space') {\n        nextSlide();\n      } else if (e.key === 'ArrowLeft') {\n        prevSlide();\n      }\n    });\n\n    // Initialize\n    updateSlide();\n  </script>\n</body>\n</html>\n","Description":"直接生成全互動式 HTML PPT 簡報檔，包含 15 頁完整的投影片、頁碼控制器、進度條、鍵盤切換、對比圖表與原廠背書連結（含 https://trust-center.jetbrains.com/）","Overwrite":true,"TargetFile":"C:\\Users\\User\\.gemini\\antigravity\\brain\\cebfe850-edaa-4bde-aa18-447bd515eeb1/jetbrains_ai_assistant_presentation.html","toolAction":"Generating interactive HTML PPT slide deck","toolSummary":"Create HTML presentation artifact"}}]}
